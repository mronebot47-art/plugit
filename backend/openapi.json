{
  "openapi": "3.0.0",
  "info": {
    "title": "PlugIt Highway EV API",
    "version": "0.1.0",
    "description": "Frozen API contract for PlugIt India EV Highway charging platform"
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "nullable": true
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "uptimeSec": {
            "type": "number"
          },
          "demoMode": {
            "type": "boolean"
          },
          "store": {
            "type": "string",
            "enum": [
              "supabase",
              "memory"
            ]
          },
          "upstreams": {
            "type": "object",
            "properties": {
              "osrm": {
                "type": "string"
              },
              "ocm": {
                "type": "string"
              }
            },
            "required": [
              "osrm",
              "ocm"
            ]
          }
        },
        "required": [
          "ok",
          "version",
          "uptimeSec",
          "demoMode",
          "store",
          "upstreams"
        ]
      },
      "Connector": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "kw": {
            "type": "number"
          },
          "qty": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "kw",
          "qty"
        ]
      },
      "Station": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "address": {
            "type": "string"
          },
          "connectors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Connector"
            }
          },
          "maxKw": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "down",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "live",
              "cache",
              "fixture",
              "community"
            ]
          },
          "communityStatus": {
            "type": "string",
            "enum": [
              "unverified",
              "confirmed"
            ]
          },
          "probFree": {
            "type": "number"
          },
          "distanceAlongRoute": {
            "type": "number"
          },
          "detourKm": {
            "type": "number"
          },
          "detourMin": {
            "type": "number"
          },
          "usageCost": {
            "type": "string"
          },
          "lastReport": {
            "type": "string"
          },
          "availability": {
            "type": "object",
            "properties": {
              "probFree": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "forecast12h": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "probFree",
              "label",
              "forecast12h"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "operator",
          "lat",
          "lng",
          "address",
          "connectors",
          "maxKw",
          "status",
          "source",
          "probFree",
          "availability"
        ]
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "usableKwh": {
            "type": "number"
          },
          "whPerKmHwy": {
            "type": "number"
          },
          "maxDcKw": {
            "type": "number"
          },
          "maxAcKw": {
            "type": "number"
          },
          "massKg": {
            "type": "number"
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approx": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "usableKwh",
          "whPerKmHwy",
          "maxDcKw",
          "maxAcKw",
          "massKg",
          "connectors"
        ]
      },
      "RouteRequest": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "lat",
              "lng"
            ]
          },
          "dest": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "lat",
              "lng"
            ]
          }
        },
        "required": [
          "origin",
          "dest"
        ]
      },
      "RouteSegment": {
        "type": "object",
        "properties": {
          "from": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lng"
            ]
          },
          "to": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lng": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lng"
            ]
          },
          "km": {
            "type": "number"
          }
        },
        "required": [
          "from",
          "to",
          "km"
        ]
      },
      "RouteData": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "LineString"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          },
          "distanceKm": {
            "type": "number"
          },
          "durationMin": {
            "type": "number"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteSegment"
            }
          },
          "degraded": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "geometry",
          "distanceKm",
          "durationMin",
          "segments"
        ]
      },
      "PlanStop": {
        "type": "object",
        "properties": {
          "station": {
            "$ref": "#/components/schemas/Station"
          },
          "arrivalSocPct": {
            "type": "number"
          },
          "departureSocPct": {
            "type": "number"
          },
          "chargeMinutes": {
            "type": "number"
          },
          "chargeKwh": {
            "type": "number"
          },
          "costInr": {
            "type": "number"
          },
          "detourMinutes": {
            "type": "number"
          },
          "reliabilityScore": {
            "type": "number"
          },
          "flag": {
            "type": "string"
          }
        },
        "required": [
          "station",
          "arrivalSocPct",
          "departureSocPct",
          "chargeMinutes",
          "chargeKwh",
          "costInr",
          "detourMinutes",
          "reliabilityScore"
        ]
      },
      "RibbonPoint": {
        "type": "object",
        "properties": {
          "distanceKm": {
            "type": "number"
          },
          "socPct": {
            "type": "number"
          }
        },
        "required": [
          "distanceKm",
          "socPct"
        ]
      },
      "TripAlternative": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "Fastest",
              "Safest"
            ]
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanStop"
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "distanceKm": {
                "type": "number"
              },
              "driveMinutes": {
                "type": "number"
              },
              "chargeMinutes": {
                "type": "number"
              },
              "totalMinutes": {
                "type": "number"
              },
              "costInr": {
                "type": "number"
              },
              "arrivalSocPct": {
                "type": "number"
              }
            },
            "required": [
              "distanceKm",
              "driveMinutes",
              "chargeMinutes",
              "totalMinutes",
              "costInr",
              "arrivalSocPct"
            ]
          },
          "calmIndex": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number"
              },
              "line": {
                "type": "string"
              }
            },
            "required": [
              "score",
              "line"
            ]
          },
          "ribbonSeries": {
            "type": "object",
            "properties": {
              "points": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RibbonPoint"
                }
              },
              "chargeBars": {
                "type": "array",
                "items": {
                  "nullable": true
                }
              }
            },
            "required": [
              "points",
              "chargeBars"
            ]
          }
        },
        "required": [
          "label",
          "stops",
          "totals",
          "calmIndex",
          "ribbonSeries"
        ]
      },
      "PlanRequest": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string"
          },
          "geometry": {
            "nullable": true
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "custom": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "startSoc": {
            "type": "number",
            "minimum": 5,
            "maximum": 100
          },
          "targetArrivalSoc": {
            "type": "number",
            "minimum": 10,
            "maximum": 100
          },
          "mode": {
            "type": "string",
            "enum": [
              "cautious",
              "normal",
              "optimistic"
            ]
          },
          "departAt": {
            "type": "string"
          },
          "includeUnverified": {
            "type": "boolean"
          }
        },
        "required": [
          "startSoc"
        ]
      },
      "PlanResponse": {
        "type": "object",
        "properties": {
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TripAlternative"
            }
          }
        },
        "required": [
          "alternatives"
        ]
      },
      "ReplanRequest": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "currentDistanceKm": {
            "type": "number"
          },
          "currentSoc": {
            "type": "number"
          },
          "failedStationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "cautious",
              "normal",
              "optimistic"
            ]
          },
          "includeUnverified": {
            "type": "boolean"
          }
        }
      },
      "ReplanResponse": {
        "type": "object",
        "properties": {
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TripAlternative"
            }
          },
          "delta": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "addedMinutes": {
                "type": "number"
              },
              "addedKm": {
                "type": "number"
              },
              "reroutedStopName": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "addedMinutes",
              "addedKm"
            ]
          }
        },
        "required": [
          "alternatives",
          "delta"
        ]
      },
      "SosRequest": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "currentSoc": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ]
      },
      "SosOption": {
        "type": "object",
        "properties": {
          "station": {
            "$ref": "#/components/schemas/Station"
          },
          "distanceKm": {
            "type": "number"
          },
          "etaMin": {
            "type": "number"
          },
          "arrivalSoc": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "station",
          "distanceKm",
          "etaMin",
          "arrivalSoc",
          "rationale"
        ]
      },
      "SosResponse": {
        "type": "object",
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SosOption"
            }
          }
        },
        "required": [
          "options"
        ]
      },
      "CommunityReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "working",
              "broken",
              "degraded"
            ]
          },
          "waitMinutes": {
            "type": "number"
          },
          "note": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "stationId",
          "status",
          "waitMinutes",
          "createdAt"
        ]
      },
      "ReportsQueryResponse": {
        "type": "object",
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunityReport"
            }
          },
          "effective": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "probFree": {
                  "type": "number"
                },
                "waitMinutes": {
                  "type": "number"
                }
              },
              "required": [
                "status",
                "probFree",
                "waitMinutes"
              ]
            }
          }
        },
        "required": [
          "reports",
          "effective"
        ]
      },
      "SaveTripRequest": {
        "type": "object",
        "properties": {
          "routeId": {
            "type": "string"
          },
          "originLabel": {
            "type": "string"
          },
          "destLabel": {
            "type": "string"
          },
          "startSoc": {
            "type": "number"
          },
          "targetArrivalSoc": {
            "type": "number"
          },
          "mode": {
            "type": "string"
          },
          "selectedLabel": {
            "type": "string"
          },
          "plan": {
            "nullable": true
          },
          "vehicle": {
            "nullable": true
          }
        }
      },
      "SaveTripResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "TripDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "routeId": {
            "type": "string"
          },
          "originLabel": {
            "type": "string"
          },
          "destLabel": {
            "type": "string"
          },
          "startSoc": {
            "type": "number"
          },
          "targetArrivalSoc": {
            "type": "number"
          },
          "mode": {
            "type": "string"
          },
          "selectedLabel": {
            "type": "string"
          },
          "plan": {
            "nullable": true
          },
          "vehicle": {
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "createdAt"
        ]
      },
      "CreateChargerRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "lat": {
            "type": "number",
            "minimum": 6,
            "maximum": 37
          },
          "lng": {
            "type": "number",
            "minimum": 68,
            "maximum": 98
          },
          "address": {
            "type": "string",
            "maxLength": 160
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "kw": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 350
                },
                "qty": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": [
                "type",
                "kw",
                "qty"
              ]
            },
            "minItems": 1,
            "maxItems": 6
          },
          "access": {
            "type": "string",
            "enum": [
              "public_free",
              "public_paid"
            ]
          },
          "priceNote": {
            "type": "string",
            "maxLength": 80
          },
          "hours": {
            "type": "string",
            "maxLength": 60
          },
          "publicConfirmed": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          }
        },
        "required": [
          "name",
          "lat",
          "lng",
          "connectors",
          "access",
          "publicConfirmed",
          "deviceId"
        ]
      },
      "CreateChargerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified"
            ]
          },
          "editToken": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "editToken"
        ]
      },
      "ConfirmChargerRequest": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64
          },
          "worked": {
            "type": "boolean"
          }
        },
        "required": [
          "deviceId",
          "worked"
        ]
      },
      "ConfirmChargerResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "unverified",
              "confirmed",
              "rejected"
            ]
          },
          "worked": {
            "type": "number"
          },
          "notWorked": {
            "type": "number"
          }
        },
        "required": [
          "ok",
          "status",
          "worked",
          "notWorked"
        ]
      },
      "AdminChargerUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "rejected",
              "removed"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health probe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/vehicles": {
      "get": {
        "summary": "List supported EV models",
        "responses": {
          "200": {
            "description": "List of vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Vehicle"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "summary": "List charging stations in bbox",
        "responses": {
          "200": {
            "description": "List of stations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stations/corridor": {
      "get": {
        "summary": "Stations along corridor route",
        "responses": {
          "200": {
            "description": "Stations along corridor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Station"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/route": {
      "post": {
        "summary": "Calculate highway route",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Route geometry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteData"
                }
              }
            }
          }
        }
      }
    },
    "/api/plan": {
      "post": {
        "summary": "Calculate charging plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          }
        },
